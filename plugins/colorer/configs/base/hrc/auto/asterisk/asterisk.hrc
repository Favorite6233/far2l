<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hrc PUBLIC "-//Cail Lomecb//DTD Colorer HRC take5//EN"
  "http://colorer.sf.net/2003/hrc.dtd">
<hrc version="take5" xmlns="http://colorer.sf.net/2003/hrc"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://colorer.sf.net/2003/hrc http://colorer.sf.net/2003/hrc.xsd">
<!--
    Asterisk: extensions.conf (диалплан) и прочие конфиги /etc/asterisk.
    Строки, которые не похожи на диалплан, отдаются схеме config:config
    (та, что в config.hrc), так что sip.conf, pjsip.conf и т.п. выглядят как раньше.
-->
   <type name="asterisk">
      <annotation>
        <documentation>Asterisk dialplan and config files</documentation>
      </annotation>

      <import type="def"/>

      <!-- парные скобки (как в config.hrc) -->
      <region name="start" parent="def:PairStart"/>
      <region name="end" parent="def:PairEnd"/>

      <!-- свои регионы: цвета наследуются от родителя, при желании их можно
           переназначить в своём .hrd, не трогая эту схему -->
      <region name="AstContext"   parent="def:Function"/>
      <region name="AstDirective" parent="def:Directive"/>
      <region name="AstExten"     parent="def:Insertion"/>
      <region name="AstPriority"  parent="def:Number"/>
      <region name="AstLabel"     parent="def:Label"/>
      <region name="AstApp"       parent="def:KeywordStrong"/>
      <region name="AstFunc"      parent="def:Keyword"/>
      <region name="AstVariable"  parent="def:Var"/>
      <region name="AstExpr"      parent="def:VarStrong"/>
      <region name="AstOp"        parent="def:Operator"/>
      <region name="AstStringEdge" parent="def:StringEdge"/>

      <!-- цвета скобок по глубине вложенности (1 - внешний уровень); после последнего цвета идёт по кругу -->
      <region name="AstBr1"        parent="def:SymbolStrong"/>
      <region name="AstBr2"        parent="def:SymbolStrong"/>
      <region name="AstBr3"        parent="def:SymbolStrong"/>
      <region name="AstBr4"        parent="def:SymbolStrong"/>
      <region name="AstBr5"        parent="def:SymbolStrong"/>
      <region name="AstBr6"        parent="def:SymbolStrong"/>


      <!-- ===== комментарии: только строчные (точка с запятой до конца строки), многострочных нет; обратный слэш перед точкой с запятой экранирует её ===== -->
      <scheme name="AstComments">
         <regexp match="/\\;/" region0="def:StringContent"/>
         <regexp match="/;.*$/" region0="def:Comment"/>
      </scheme>

      <!-- ===== схемы по уровням вложенности (сгенерированы): AstOpenN - открывающие скобки уровня N,
                 Ast*BodyN - содержимое скобки уровня N. Лишняя или не та закрывающая скобка внутри - def:Error ===== -->
      <scheme name="AstOpenSubst1">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody1" region="AstVariable"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody1" region="AstExpr"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
      </scheme>

      <scheme name="AstOpen1">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody1" region="AstVariable"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody1" region="AstExpr"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
         <block start="/(\()/" end="/(\))|$/" scheme="AstParenBody1"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
         <block start="/(\{)/" end="/(\})|$/" scheme="AstBraceBody1"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
         <block start="/(\[)/" end="/(\])|$/" scheme="AstBracketBody1"
                region00="AstBr1" region01="start" region10="AstBr1" region11="end"/>
      </scheme>

      <scheme name="AstStr1">
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpenSubst1"/>
      </scheme>

      <scheme name="AstOpenSubst2">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody2" region="AstVariable"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody2" region="AstExpr"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
      </scheme>

      <scheme name="AstOpen2">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody2" region="AstVariable"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody2" region="AstExpr"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
         <block start="/(\()/" end="/(\))|$/" scheme="AstParenBody2"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
         <block start="/(\{)/" end="/(\})|$/" scheme="AstBraceBody2"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
         <block start="/(\[)/" end="/(\])|$/" scheme="AstBracketBody2"
                region00="AstBr2" region01="start" region10="AstBr2" region11="end"/>
      </scheme>

      <scheme name="AstStr2">
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpenSubst2"/>
      </scheme>

      <scheme name="AstOpenSubst3">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody3" region="AstVariable"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody3" region="AstExpr"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
      </scheme>

      <scheme name="AstOpen3">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody3" region="AstVariable"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody3" region="AstExpr"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
         <block start="/(\()/" end="/(\))|$/" scheme="AstParenBody3"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
         <block start="/(\{)/" end="/(\})|$/" scheme="AstBraceBody3"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
         <block start="/(\[)/" end="/(\])|$/" scheme="AstBracketBody3"
                region00="AstBr3" region01="start" region10="AstBr3" region11="end"/>
      </scheme>

      <scheme name="AstStr3">
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpenSubst3"/>
      </scheme>

      <scheme name="AstOpenSubst4">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody4" region="AstVariable"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody4" region="AstExpr"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
      </scheme>

      <scheme name="AstOpen4">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody4" region="AstVariable"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody4" region="AstExpr"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
         <block start="/(\()/" end="/(\))|$/" scheme="AstParenBody4"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
         <block start="/(\{)/" end="/(\})|$/" scheme="AstBraceBody4"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
         <block start="/(\[)/" end="/(\])|$/" scheme="AstBracketBody4"
                region00="AstBr4" region01="start" region10="AstBr4" region11="end"/>
      </scheme>

      <scheme name="AstStr4">
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpenSubst4"/>
      </scheme>

      <scheme name="AstOpenSubst5">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody5" region="AstVariable"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody5" region="AstExpr"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
      </scheme>

      <scheme name="AstOpen5">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody5" region="AstVariable"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody5" region="AstExpr"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
         <block start="/(\()/" end="/(\))|$/" scheme="AstParenBody5"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
         <block start="/(\{)/" end="/(\})|$/" scheme="AstBraceBody5"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
         <block start="/(\[)/" end="/(\])|$/" scheme="AstBracketBody5"
                region00="AstBr5" region01="start" region10="AstBr5" region11="end"/>
      </scheme>

      <scheme name="AstStr5">
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpenSubst5"/>
      </scheme>

      <scheme name="AstOpenSubst6">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody6" region="AstVariable"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody6" region="AstExpr"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
      </scheme>

      <scheme name="AstOpen6">
         <block start="/(\$\{)/" end="/(\})|$/" scheme="AstVarBody6" region="AstVariable"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
         <block start="/(\$\[)/" end="/(\])|$/" scheme="AstExprBody6" region="AstExpr"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
         <block start="/(\()/" end="/(\))|$/" scheme="AstParenBody6"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
         <block start="/(\{)/" end="/(\})|$/" scheme="AstBraceBody6"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
         <block start="/(\[)/" end="/(\])|$/" scheme="AstBracketBody6"
                region00="AstBr6" region01="start" region10="AstBr6" region11="end"/>
      </scheme>

      <scheme name="AstStr6">
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpenSubst6"/>
      </scheme>

      <scheme name="AstParenBody1">
         <inherit scheme="AstComments"/>
         <regexp match="/[\}\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen2"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr2" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBraceBody1">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen2"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr2" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBracketBody1">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen2"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr2" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstVarBody1">
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen2"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/[,:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstExprBody1">
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <inherit scheme="AstOpen2"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr2" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[=!&lt;&gt;~+\-*\/%|&amp;?:]+/" region0="AstOp"/>
      </scheme>

      <scheme name="AstParenBody2">
         <inherit scheme="AstComments"/>
         <regexp match="/[\}\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen3"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr3" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBraceBody2">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen3"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr3" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBracketBody2">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen3"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr3" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstVarBody2">
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen3"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/[,:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstExprBody2">
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <inherit scheme="AstOpen3"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr3" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[=!&lt;&gt;~+\-*\/%|&amp;?:]+/" region0="AstOp"/>
      </scheme>

      <scheme name="AstParenBody3">
         <inherit scheme="AstComments"/>
         <regexp match="/[\}\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen4"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr4" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBraceBody3">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen4"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr4" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBracketBody3">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen4"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr4" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstVarBody3">
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen4"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/[,:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstExprBody3">
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <inherit scheme="AstOpen4"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr4" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[=!&lt;&gt;~+\-*\/%|&amp;?:]+/" region0="AstOp"/>
      </scheme>

      <scheme name="AstParenBody4">
         <inherit scheme="AstComments"/>
         <regexp match="/[\}\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen5"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr5" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBraceBody4">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen5"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr5" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBracketBody4">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen5"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr5" region="def:String"
