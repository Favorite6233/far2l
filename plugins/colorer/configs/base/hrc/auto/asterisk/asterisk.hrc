         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstVarBody4">
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen5"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/[,:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstExprBody4">
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <inherit scheme="AstOpen5"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr5" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[=!&lt;&gt;~+\-*\/%|&amp;?:]+/" region0="AstOp"/>
      </scheme>

      <scheme name="AstParenBody5">
         <inherit scheme="AstComments"/>
         <regexp match="/[\}\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen6"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr6" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBraceBody5">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen6"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr6" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBracketBody5">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen6"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr6" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstVarBody5">
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen6"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/[,:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstExprBody5">
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <inherit scheme="AstOpen6"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr6" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[=!&lt;&gt;~+\-*\/%|&amp;?:]+/" region0="AstOp"/>
      </scheme>

      <scheme name="AstParenBody6">
         <inherit scheme="AstComments"/>
         <regexp match="/[\}\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen1"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr1" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBraceBody6">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen1"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr1" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstBracketBody6">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <regexp match="/\\./" region0="def:StringContent"/>
         <inherit scheme="AstOpen1"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr1" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[,|&amp;?:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstVarBody6">
         <regexp match="/[\)\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen1"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/[,:]/" region0="def:Symbol"/>
      </scheme>

      <scheme name="AstExprBody6">
         <regexp match="/[\)\}]/" region0="def:Error"/>
         <inherit scheme="AstOpen1"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr1" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <regexp match="/\b[A-Za-z_]\w*\M\(/" region0="AstFunc"/>
         <regexp match="/\b\d+(\.\d+)?\b/" region0="def:Number"/>
         <regexp match="/[=!&lt;&gt;~+\-*\/%|&amp;?:]+/" region0="AstOp"/>
      </scheme>


      <!-- хвост строки exten/same после "приоритет," : (аргументы) и комментарий -->
      <scheme name="AstAppLine">
         <inherit scheme="AstComments"/>
         <regexp match="/[\)\}\]]/" region0="def:Error"/>
         <inherit scheme="AstOpen1"/>
      </scheme>

      <!-- хвост #include / #exec -->
      <scheme name="AstDirectiveRest">
         <inherit scheme="AstComments"/>
         <inherit scheme="AstOpenSubst1"/>
         <block start="/(&quot;)/" end="/(&quot;)|$/" scheme="AstStr1" region="def:String"
                region00="AstStringEdge" region10="AstStringEdge"/>
         <block start="/(&lt;)/" end="/(&gt;)|$/" scheme="def:empty" region="def:String"/>
      </scheme>


      <!-- ===== основная схема ===== -->
      <scheme name="asterisk">
         <inherit scheme="AstComments"/>

         <!-- [context] -->
         <block start="/^\s*(\[)/" end="/(\])/" scheme="def:empty" region="AstContext"
                region00="def:SymbolStrong" region10="def:SymbolStrong" region01="start" region11="end"/>

         <!-- #include / #tryinclude / #exec -->
         <block start="/^\s*(\#(?:include|tryinclude|exec))\b/i" end="/$/" scheme="AstDirectiveRest"
                region01="AstDirective"/>

         <!-- exten => шаблон,приоритет(метка),Приложение(аргументы)
              группы: 1 exten, 2 =>, 3 шаблон, 4 приоритет, 5 "(", 6 метка, 7 ")", 8 приложение.
              Первый вариант - строка со сбалансированными скобками (проверка (?=...) по всей строке),
              второй - то же самое, но слово exten красится как ошибка. -->
         <block start="/^(?:(?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.))*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*(?:;.*)?$)?=\s*(exten)\s*(=&gt;?)\s*([^,;\s]+)\s*,\s*(\w+)(?:(\()(\w+)(\)))?\s*,\s*([A-Za-z_]\w*)?/i"
                end="/$/" scheme="AstAppLine"
                region01="AstDirective" region02="def:Symbol" region03="AstExten" region04="AstPriority"
                region05="start" region06="AstLabel" region07="end" region08="AstApp"/>
         <block start="/^\s*(exten)\s*(=&gt;?)\s*([^,;\s]+)\s*,\s*(\w+)(?:(\()(\w+)(\)))?\s*,\s*([A-Za-z_]\w*)?/i"
                end="/$/" scheme="AstAppLine"
                region01="def:Error" region02="def:Symbol" region03="AstExten" region04="AstPriority"
                region05="start" region06="AstLabel" region07="end" region08="AstApp"/>

         <!-- same => приоритет(метка),Приложение(аргументы)
              группы: 1 same, 2 =>, 3 приоритет, 4 "(", 5 метка, 6 ")", 7 приложение -->
         <block start="/^(?:(?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.)|[\(\{\[](?:(?:[^\(\)\{\}\[\];\\]|\\.))*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*[\)\}\]])*(?:;.*)?$)?=\s*(same)\s*(=&gt;?)\s*(\w+)(?:(\()(\w+)(\)))?\s*,\s*([A-Za-z_]\w*)?/i"
                end="/$/" scheme="AstAppLine"
                region01="AstDirective" region02="def:Symbol" region03="AstPriority"
                region04="start" region05="AstLabel" region06="end" region07="AstApp"/>
         <block start="/^\s*(same)\s*(=&gt;?)\s*(\w+)(?:(\()(\w+)(\)))?\s*,\s*([A-Za-z_]\w*)?/i"
                end="/$/" scheme="AstAppLine"
                region01="def:Error" region02="def:Symbol" region03="AstPriority"
                region04="start" region05="AstLabel" region06="end" region07="AstApp"/>

         <!-- include => контекст -->
         <regexp match="/^\s*(include)\s*(=&gt;?)\s*([^;\s]+)?/i"
                 region1="AstDirective" region2="def:Symbol" region3="AstContext"/>

         <!-- switch / ignorepat / autohints / catch -->
         <regexp match="/^\s*(switch|ignorepat|autohints|catch)\s*(=&gt;?)/i"
                 region1="AstDirective" region2="def:Symbol"/>

         <!-- имя = значение (секции [globals], [general], и обычные ini-параметры) -->
         <regexp match="/^\s*([A-Za-z_][\w.\-]*)\s*\M=(?:[^&gt;]|$)/" region1="AstVariable"/>

         <!-- всё остальное - как обычный config -->
         <inherit scheme="config:config"/>
      </scheme>

   </type>
</hrc>
